<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background Layer (hỗ trợ setImageAlpha, theme Sáng/Tối, và WidgetStyle) -->
    <ImageView
        android:id="@+id/widget_bg_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_dark" />

    <!-- Foreground Content Layer -->
    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <!-- Top Row: City Name, Weather Icon, Main Temp & Refresh Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_city_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="Hà Nội"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_weather_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="Trời nắng • Cảm giác 30°C"
                    android:textColor="#CBD5E1"
                    android:textSize="10.5sp" />

                <TextView
                    android:id="@+id/widget_range"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="Cao: 32° • Thấp: 24°"
                    android:textColor="#38BDF8"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_weather_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="☀️"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/widget_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="28°"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_btn_refresh"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_refresh_btn_bg_dark"
                android:contentDescription="Làm mới thời tiết"
                android:padding="5dp"
                android:src="@drawable/ic_refresh" />
        </LinearLayout>
 
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Hourly Forecast Section (6 Upcoming Hours Timeline) -->
        <LinearLayout
            android:id="@+id/widget_hourly_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Hour 1 -->
            <LinearLayout
                android:id="@+id/widget_h1_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="1.5dp"
                android:background="@drawable/widget_hour_chip_dark"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:paddingStart="1.5dp"
                android:paddingEnd="1.5dp">

                <TextView
                    android:id="@+id/widget_h1_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="14:00"
                    android:textColor="#94A3B8"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_h1_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="☀️"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/widget_h1_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:singleLine="true"
                    android:text="30°"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_h1_rain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="0%"
                    android:textColor="#38BDF8"
                    android:textSize="8.5sp" />
            </LinearLayout>

            <!-- Hour 2 -->
            <LinearLayout
                android:id="@+id/widget_h2_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="1.5dp"
                android:layout_marginEnd="1.5dp"
                android:background="@drawable/widget_hour_chip_dark"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:paddingStart="1.5dp"
                android:paddingEnd="1.5dp">

                <TextView
                    android:id="@+id/widget_h2_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="15:00"
                    android:textColor="#94A3B8"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_h2_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="🌤️"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/widget_h2_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:singleLine="true"
                    android:text="29°"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_h2_rain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="10%"
                    android:textColor="#38BDF8"
                    android:textSize="8.5sp" />
            </LinearLayout>

            <!-- Hour 3 -->
            <LinearLayout
                android:id="@+id/widget_h3_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="1.5dp"
                android:layout_marginEnd="1.5dp"
                android:background="@drawable/widget_hour_chip_dark"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:paddingStart="1.5dp"
                android:paddingEnd="1.5dp">

                <TextView
                    android:id="@+id/widget_h3_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="16:00"
                    android:textColor="#94A3B8"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_h3_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="☁️"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/widget_h3_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:singleLine="true"
                    android:text="28°"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_h3_rain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="20%"
                    android:textColor="#38BDF8"
                    android:textSize="8.5sp" />
            </LinearLayout>

            <!-- Hour 4 -->
            <LinearLayout
                android:id="@+id/widget_h4_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="1.5dp"
                android:layout_marginEnd="1.5dp"
                android:background="@drawable/widget_hour_chip_dark"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:paddingStart="1.5dp"
                android:paddingEnd="1.5dp">

                <TextView
                    android:id="@+id/widget_h4_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="17:00"
                    android:textColor="#94A3B8"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_h4_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="🌦️"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/widget_h4_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:singleLine="true"
                    android:text="27°"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_h4_rain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="40%"
                    android:textColor="#38BDF8"
                    android:textSize="8.5sp" />
            </LinearLayout>

            <!-- Hour 5 -->
            <LinearLayout
                android:id="@+id/widget_h5_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="1.5dp"
                android:layout_marginEnd="1.5dp"
                android:background="@drawable/widget_hour_chip_dark"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:paddingStart="1.5dp"
                android:paddingEnd="1.5dp">

                <TextView
                    android:id="@+id/widget_h5_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="18:00"
                    android:textColor="#94A3B8"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_h5_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="🌙"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/widget_h5_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:singleLine="true"
                    android:text="26°"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_h5_rain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="10%"
                    android:textColor="#38BDF8"
                    android:textSize="8.5sp" />
            </LinearLayout>

            <!-- Hour 6 -->
            <LinearLayout
                android:id="@+id/widget_h6_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="1.5dp"
                android:background="@drawable/widget_hour_chip_dark"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:paddingStart="1.5dp"
                android:paddingEnd="1.5dp">

                <TextView
                    android:id="@+id/widget_h6_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="19:00"
                    android:textColor="#94A3B8"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_h6_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="🌙"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/widget_h6_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:singleLine="true"
                    android:text="25°"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_h6_rain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="0%"
                    android:textColor="#38BDF8"
                    android:textSize="8.5sp" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Bottom Row: AI Stylist Tip & Updated time -->
        <LinearLayout
            android:id="@+id/widget_bottom_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_ai_tip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:text="👔 AI Stylist: Áo thun mỏng nhẹ thoáng mát"
                android:textColor="#F0ABFC"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:singleLine="true"
                android:text="Weather 24h"
                android:textColor="#94A3B8"
                android:textSize="9sp" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
